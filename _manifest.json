{
  "manifest_version": 2,
  "version": "4.1.0",
  "name": "maibot-quota-router-plugin",
  "description": "单模型每日 Token 配额、自动降级路由与兼容的 LLM 消耗限速",
  "author": {
    "name": "DavidBlackCN",
    "url": "https://github.com/DavidBlackCN"
  },
  "license": "AGPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/DavidBlackCN/maibot-quota-router-plugin",
    "homepage": "https://github.com/DavidBlackCN/maibot-quota-router-plugin",
    "issues": "https://github.com/DavidBlackCN/maibot-quota-router-plugin/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.2.4",
    "max_version": "1.2.5"
  },
  "sdk": {
    "min_version": "2.8.0",
    "max_version": "2.8.0"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "config.get",
    "database.query",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "chat.open_session"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "maibot_plugin.hold_on"
}
